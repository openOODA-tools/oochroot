// # oochroot Synthetic Demonstration Subsystem
//
// Logline: Generates simulated jail environments, mount plans, and security audit fixtures.
//
// Setup: Supplies deterministic jail scenarios for hermetic testing and verification pipelines.
//
// Beats:
//   1. Produce synthetic Alpine Linux container jail inspection.
//   2. Produce demonstration pseudofs mount plan.
//   3. Synthesize demonstration systemd service confinement unit.
//   4. Deliver deterministic audit findings and readiness summary.

import "core/chroot_types.oo";
import "core/chroot_plan.oo";

pub fn build_demo_inspection() -> JailInspection {
    return make_jail_inspection(
        "/var/lib/jails/alpine-edge",
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        "/bin/sh",
        "READY"
    );
}

pub fn build_demo_mounts() -> List[MountPlanEntry] {
    return build_mount_plan("/var/lib/jails/alpine-edge", true);
}

pub fn build_demo_systemd() -> SystemdChrootUnit {
    return make_systemd_unit(
        "oochroot-alpine",
        "/var/lib/jails/alpine-edge",
        "/bin/sh -c 'echo sovereign jail online'",
        "sandbox:sandbox",
        "strict",
        "yes",
        true,
        true,
        true,
        "CAP_NET_BIND_SERVICE"
    );
}

pub fn build_demo_findings() -> List[AuditFinding] {
    let mut findings: List[AuditFinding] = list_new();
    findings = list_push(findings, make_audit_finding(
        "OK",
        "PERM_ROOT_CONFINED",
        "Root filesystem permissions 0755 root:root",
        "Maintain current ownership and permissions"
    ));
    findings = list_push(findings, make_audit_finding(
        "INFO",
        "PSEUDOFS_REQUIRED",
        "API virtual filesystems (/proc, /sys, /dev) need mounting",
        "Use MountAPIVFS=yes or oochroot mount plan"
    ));
    findings = list_push(findings, make_audit_finding(
        "OK",
        "NO_SUID_LEAKS",
        "No setuid/setgid binaries detected inside jail boundary",
        "Maintain nosuid mount options on host"
    ));
    return findings;
}

pub fn build_demo_summary() -> ChrootSummary {
    return make_chroot_summary("/var/lib/jails/alpine-edge", 3, 2, 0, 0, 100);
}
